@model TechRent.Models.Entities.LoginViewModel
@{
    ViewData["Title"] = "Авторизация";
    ViewData["css"] = "auth";

    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var validationErrors = ViewData.ModelState
        .Where(x => x.Value.Errors.Any())
        .SelectMany(x => x.Value.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .Distinct()
        .ToList();
}

<!-- Main Content -->
<main class="auth-main">
    <div class="auth-container">
        <div class="auth-card">
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success" role="status">
                    <ul>
                        <li>@successMessage</li>
                    </ul>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <ul>
                        <li>@errorMessage</li>
                    </ul>
                </div>
            }

            @if (validationErrors.Any())
            {
                <div class="alert alert-danger" role="alert">
                    <ul>
                        @foreach (var error in validationErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <!-- Header -->
            <div class="auth-header">
                <h1 class="auth-title">С возвращением</h1>
                <p class="auth-subtitle">Войдите в свой аккаунт, чтобы продолжить</p>
            </div>


            <!-- Login Form -->
            <form class="auth-form" asp-controller="Account" asp-action="Auth" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="form-group">
                    <label class="form-label" for="Email">Электронная почта</label>
                    <div class="input-wrapper">
                        <span class="input-icon material-symbols-outlined">mail</span>
                        <input type="email" id="Email" name="Email" class="form-input" placeholder="Введите вашу почту" value="@(Model?.Email)" autocomplete="username" required>
                    </div>
                </div>

                <div class="form-group">
                    <div class="password-header">
                        <label class="form-label" for="Password">Пароль</label>
                        <a href="#" class="forgot-link">Забыли пароль?</a>
                    </div>
                    <div class="input-wrapper">
                        <span class="input-icon material-symbols-outlined">lock</span>
                        <input type="password" id="Password" name="Password" class="form-input" placeholder="Введите ваш пароль" autocomplete="current-password" required>
                        <button type="button" class="password-toggle" onclick="togglePassword()">
                            <span class="material-symbols-outlined">visibility_off</span>
                        </button>
                    </div>
                </div>

                <div class="form-options">
                    <label class="checkbox-label">
                        <input type="checkbox" name="RememberMe" value="true" class="checkbox-input" checked="@(Model?.RememberMe == true)">
                        <span class="checkbox-custom"></span>
                        <span class="checkbox-text">Запомнить меня</span>
                    </label>
                </div>

                <button type="submit" class="auth-button">Войти</button>
            </form>

            <!-- Footer Link -->
            <div class="auth-footer">
                <p>Нет аккаунта? <a asp-controller="Account" asp-action="Register" class="auth-link">Зарегистрироваться</a></p>
            </div>
        </div>
    </div>
</main>

<script>
    function togglePassword() {
        const passwordInput = document.getElementById('Password');
        const toggleButton = document.querySelector('.password-toggle span');

        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            toggleButton.textContent = 'visibility';
        } else {
            passwordInput.type = 'password';
            toggleButton.textContent = 'visibility_off';
        }
    }
</script>
