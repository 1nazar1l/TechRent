@model IEnumerable<TechRent.Models.Entities.Equipment>
@{
    ViewData["Title"] = "Аренда офисного оборудования | RentOffice";
    ViewData["css"] = "index";
    ViewData["header"] = "base_header";
}

<!-- Hero Section -->
<section class="hero-rent">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <span class="hero-badge">
            <span class="live-dot"></span>
            Бронирование за 2 минуты
        </span>
        <h1 class="hero-title">
            Аренда офисного оборудования<br><span class="highlight">без скрытых платежей</span>
        </h1>
        <p class="hero-description">
            Более 3000 единиц оргтехники от проверенных поставщиков. Доставка в офис за 2 часа.
        </p>
        <div class="hero-buttons">
            <a href="@Url.Action("Index", "Equipment")" class="btn btn-primary">Выбрать оборудование</a>
            <a href="#" class="btn btn-outline">Как это работает</a>
        </div>
    </div>
</section>

<main class="content-container">
    <!-- Popular Categories -->
    <section class="categories-section">
        <div class="section-header">
            <h2 class="section-title">Популярные категории</h2>
            <a href="#" class="link-arrow">Все категории →</a>
        </div>
        <div class="categories-grid">
            <a href="#" class="category-card">
                <div class="category-icon-circle">
                    <span class="material-symbols-outlined category-icon">print</span>
                </div>
                <span class="category-title">Принтеры и МФУ</span>
            </a>
            <a href="#" class="category-card">
                <div class="category-icon-circle">
                    <span class="material-symbols-outlined category-icon">computer</span>
                </div>
                <span class="category-title">Компьютеры</span>
            </a>
            <a href="#" class="category-card">
                <div class="category-icon-circle">
                    <span class="material-symbols-outlined category-icon">videocam</span>
                </div>
                <span class="category-title">Видеоконференции</span>
            </a>
            <a href="#" class="category-card">
                <div class="category-icon-circle">
                    <span class="material-symbols-outlined category-icon">chair</span>
                </div>
                <span class="category-title">Офисная мебель</span>
            </a>
            <a href="#" class="category-card">
                <div class="category-icon-circle">
                    <span class="material-symbols-outlined category-icon">kitchen</span>
                </div>
                <span class="category-title">Кухонное оборудование</span>
            </a>
            <a href="#" class="category-card">
                <div class="category-icon-circle">
                    <span class="material-symbols-outlined category-icon">grid_view</span>
                </div>
                <span class="category-title">Все категории</span>
            </a>
        </div>
    </section>

    <!-- How It Works -->
    <section class="steps-section">
        <div class="section-header centered">
            <h2 class="section-title">Начните работу за 4 шага</h2>
            <p class="section-subtitle">Прозрачная аренда без лишних документов</p>
        </div>
        <div class="steps-grid">
            <div class="step-card">
                <div class="step-number">01</div>
                <span class="step-icon material-symbols-outlined">search</span>
                <h3>Выберите оборудование</h3>
                <p>Каталог с фильтрами по цене, производителю и типу техники</p>
            </div>
            <div class="step-card">
                <div class="step-number">02</div>
                <span class="step-icon material-symbols-outlined">calendar_month</span>
                <h3>Укажите даты</h3>
                <p>Гибкие тарифы: почасовая, посуточная, на месяц</p>
            </div>
            <div class="step-card">
                <div class="step-number">03</div>
                <span class="step-icon material-symbols-outlined">verified</span>
                <h3>Подтверждение</h3>
                <p>Онлайн‑договор и безопасная оплата</p>
            </div>
            <div class="step-card">
                <div class="step-number">04</div>
                <span class="step-icon material-symbols-outlined">local_shipping</span>
                <h3>Доставка</h3>
                <p>Привезём в офис в течение 2 часов</p>
            </div>
        </div>
    </section>

    <!-- Popular Products (динамические) -->
    <section class="products-section">
        <div class="section-header">
            <h2 class="section-title">Популярное сейчас</h2>
            <a href="@Url.Action("Index", "Equipment")" class="link-arrow">Смотреть всё →</a>
        </div>
        <div class="products-grid">
            @foreach (var item in Model.Take(4))
            {
                var averageRating = item.Reviews != null && item.Reviews.Any()
                ? item.Reviews.Average(r => r.Rating).ToString("F1")
                : "0.0";
                var reviewCount = item.Reviews?.Count ?? 0;
                var roundedRating = item.Reviews != null && item.Reviews.Any()
                ? (int)Math.Round(item.Reviews.Average(r => r.Rating))
                : 0;

                <article class="product-card">
                    <div class="product-image-wrapper">
                        <div class="product-badge">
                            @if (item.AvailableQuantity > 5)
                            {
                                <span class="badge badge-available">В наличии</span>
                            }
                            else if (item.AvailableQuantity > 0)
                            {
                                <span class="badge badge-lowstock">Мало</span>
                            }
                            else
                            {
                                <span class="badge badge-outofstock">Нет в наличии</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img class="product-image" src="@item.ImageUrl" alt="@item.Name">
                        }
                        else
                        {
                            <div class="product-image" style="background: #f1f5f9; display: flex; align-items: center; justify-content: center;">
                                <span class="material-symbols-outlined" style="font-size: 48px; color: #94a3b8;">print</span>
                            </div>
                        }
                    </div>
                    <div class="product-details">
                        <div class="rating">
                            @for (int i = 0; i < 5; i++)
                            {
                                if (i < roundedRating)
                                {
                                    <span class="material-symbols-outlined filled-star">star</span>
                                }
                                else
                                {
                                    <span class="material-symbols-outlined empty-star">star</span>
                                }
                            }
                            <span class="rating-value">@averageRating</span>
                            <span class="rating-count">(@reviewCount)</span>
                        </div>
                        <h3 class="product-name">@item.Name</h3>
                        <div class="product-footer">
                            <div class="price-wrapper">
                                <span class="price">@item.PricePerDay<span class="br-icon"></span></span>
                                <span class="price-period">/день</span>
                            </div>
                            <a href="@Url.Action("Index", "Product", new { id = item.Id })" class="add-to-cart-button">
                                <span class="material-symbols-outlined">add</span>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    </section>

    <!-- Две колонки: доставка + отзыв -->
    <div class="double-grid">
        <div class="delivery-card">
            <div class="delivery-bg"></div>
            <div class="delivery-content">
                <h3>Рассчитать доставку</h3>
                <p>Введите адрес офиса – узнайте точную стоимость и время прибытия</p>
                <div class="address-input">
                    <input type="text" placeholder="Адрес офиса">
                    <button><span class="material-symbols-outlined">arrow_forward</span></button>
                </div>
                <div class="drivers">
                    <div class="driver-avatars">
                        <img src="https://randomuser.me/api/portraits/men/1.jpg" alt="">
                        <img src="https://randomuser.me/api/portraits/men/2.jpg" alt="">
                        <span>+24</span>
                    </div>
                    <span><strong>26 курьеров</strong> рядом с вами</span>
                </div>
            </div>
        </div>
        <div class="testimonial-card">
            <div class="testimonial-rating">
                <span class="material-symbols-outlined filled-star">star</span>
                <span class="material-symbols-outlined filled-star">star</span>
                <span class="material-symbols-outlined filled-star">star</span>
                <span class="material-symbols-outlined filled-star">star</span>
                <span class="material-symbols-outlined filled-star">star</span>
            </div>
            <p class="testimonial-text">«Заказали МФУ на время ремонта – привезли на следующий день, установили и настроили. Отличный сервис!»</p>
            <div class="testimonial-author">
                <img src="https://randomuser.me/api/portraits/men/42.jpg" alt="">
                <div>
                    <strong>Алексей Ковалёв</strong>
                    <span>IT-директор, ООО "ТехноСервис"</span>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA -->
    <section class="cta-block">
        <h2>Готовы оснастить офис?</h2>
        <p>Присоединяйтесь к 5000+ компаний, которые арендуют оборудование с RentOffice.</p>
        <div class="cta-buttons">
            <a href="@Url.Action("Index", "Equipment")" class="btn btn-primary-light">Перейти в каталог</a>
            <a href="#" class="btn btn-outline-light">Стать поставщиком</a>
        </div>
    </section>
</main>