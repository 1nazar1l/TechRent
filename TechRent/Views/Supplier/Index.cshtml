@using TechRent.Models.Entities
@model SupplierViewModel
@{
    ViewData["Title"] = "Панель поставщика";
    ViewData["css"] = "supplier";
    ViewData["nav_pos"] = "left";
    ViewData["header"] = "with_search";
}

<!-- Яндекс.Карты -->
<script src="https://api-maps.yandex.ru/2.1/?apikey=0d3a4764-1b1f-41ba-bc00-42c76b73e45f&lang=ru_RU" type="text/javascript"></script>

<main class="main-content">
    <div class="supplier-container">
        <!-- Breadcrumb -->
        <div class="breadcrumb">
            <a href="@Url.Action("Index", "Home")" class="breadcrumb-link">Главная</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <span class="breadcrumb-current">Панель поставщика</span>
        </div>

        <!-- Page Header -->
        <div class="supplier-header">
            <div>
                <h1 class="page-title">Панель поставщика</h1>
                <p class="page-description">Управляйте своим оборудованием и отслеживайте аренды</p>
            </div>
            <button class="add-equipment-button" onclick="location.href='@Url.Action("Create", "Supplier")'">
                <span class="material-symbols-outlined">add</span>
                Добавить оборудование
            </button>
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">
                    <span class="material-symbols-outlined">inventory</span>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@Model.TotalEquipment</span>
                    <span class="stat-label">Всего оборудования</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <span class="material-symbols-outlined">check_circle</span>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@Model.ActiveRentals</span>
                    <span class="stat-label">Активных аренд</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <span class="material-symbols-outlined">attach_money</span>
                </div>
                <div class="stat-info">
                    <span class="stat-value">$@Model.TotalEarnings.ToString("N0")</span>
                    <span class="stat-label">Общий доход</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <span class="material-symbols-outlined">star</span>
                </div>
                <div class="stat-info">
                    <span class="stat-value">@Model.AverageRating.ToString("F1")</span>
                    <span class="stat-label">Средний рейтинг</span>
                </div>
            </div>
        </div>

        <!-- Toolbar -->
        <div class="supplier-toolbar">
            <div class="results">
                <span class="results-number">@Model.Equipment.Count()</span>
                <span class="results-text">оборудования</span>
            </div>
            <div class="search-filter">
                <div class="search-input-wrapper">
                    <span class="search-icon material-symbols-outlined">search</span>
                    <input type="text" id="searchEquipment" class="search-equipment-input" placeholder="Поиск по названию...">
                </div>
                <div class="filter-select-wrapper">
                    <select id="categoryFilter" class="category-filter-select">
                        <option value="">Все категории</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Name">@category.Name</option>
                        }
                    </select>
                    <span class="filter-icon material-symbols-outlined">expand_more</span>
                </div>
            </div>
        </div>

        <!-- Equipment Table -->
        <div class="supplier-table-wrapper">
            <table class="supplier-table" id="equipmentTable">
                <thead>
                    <tr>
                        <th>Фото</th>
                        <th>Название</th>
                        <th>Категория</th>
                        <th>Цена/день</th>
                        <th>Залог</th>
                        <th>В наличии</th>
                        <th>Статус</th>
                        <th>Аренд</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Equipment)
                    {
                        <tr data-category="@item.Category?.Name">
                            <td class="image-cell">
                                <div class="equipment-thumb">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name">
                                    }
                                    else
                                    {
                                        <div class="thumb-placeholder">
                                            <span class="material-symbols-outlined">construction</span>
                                        </div>
                                    }
                                </div>
                            </td>
                            <td class="name-cell">
                                <div>
                                    <strong>@item.Name</strong>
                                    <span class="equipment-id">ID: @item.Id.ToString("D4")</span>
                                </div>
                            </td>
                            <td>@(item.Category?.Name ?? "—")</td>
                            <td class="price-cell">$@item.PricePerDay.ToString("F0")</td>
                            <td class="deposit-cell">$@item.Deposit.ToString("F0")</td>
                            <td class="stock-cell">
                                @if (item.AvailableQuantity > 5)
                                {
                                    <span class="stock-badge stock-high">@item.AvailableQuantity шт.</span>
                                }
                                else if (item.AvailableQuantity > 0)
                                {
                                    <span class="stock-badge stock-low">@item.AvailableQuantity шт.</span>
                                }
                                else
                                {
                                    <span class="stock-badge stock-out">Нет в наличии</span>
                                }
                            </td>
                            <td class="status-cell">
                                @if (item.IsAvailable)
                                {
                                    <span class="status-badge status-active">Активен</span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">Неактивен</span>
                                }
                            </td>
                            <td class="rentals-cell">@item.TotalRentals</td>
                            <td class="actions-cell">
                                <div class="action-buttons">
                                    <button class="action-button view-button" title="Просмотр" onclick="location.href='@Url.Action("Index", "Product", new { id = item.Id })'">
                                        <span class="material-symbols-outlined">visibility</span>
                                    </button>
                                    <button class="action-button edit-button" onclick="location.href='@Url.Action("Edit", "Supplier", new { id = item.Id })'" title="Редактировать">
                                        <span class="material-symbols-outlined">edit</span>
                                    </button>
                                    <button class="action-button delete-button" onclick="location.href='@Url.Action("Delete", "Supplier", new { id = item.Id })'" title="Удалить">
                                        <span class="material-symbols-outlined">delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Empty State -->
        @if (!Model.Equipment.Any())
        {
            <div class="empty-supplier-state">
                <span class="material-symbols-outlined">inventory_2</span>
                <h3>Нет оборудования</h3>
                <p>Добавьте своё первое оборудование, чтобы начать зарабатывать</p>
                <button class="add-equipment-button" onclick="location.href='@Url.Action("Create", "Supplier")'">
                    <span class="material-symbols-outlined">add</span>
                    Добавить оборудование
                </button>
            </div>
        }

        <!-- Map Section -->
        <div class="map-section">
            <div class="map-header">
                <div>
                    <h3 class="map-title">
                        <span class="material-symbols-outlined">location_on</span>
                        Расположение офиса
                    </h3>
                    @if (Model.Office != null)
                    {
                        <p class="map-subtitle">@Model.Office.Address</p>
                    }
                    else
                    {
                        <p class="map-subtitle">Офис не добавлен. Добавьте информацию о вашем офисе.</p>
                    }
                </div>
                @if (Model.Office != null)
                {
                    <div style="display: flex; gap: 8px;">
                        <button class="edit-office-button" onclick="location.href='@Url.Action("EditOffice", "Supplier")'">
                            <span class="material-symbols-outlined">edit</span>
                            Редактировать офис
                        </button>
                        <button class="delete-office-button" onclick="location.href='@Url.Action("DeleteOffice", "Supplier")'" style="background: #ef4444;">
                            <span class="material-symbols-outlined">delete</span>
                            Удалить офис
                        </button>
                    </div>
                }
                else
                {
                    <button class="add-office-button" onclick="location.href='@Url.Action("CreateOffice", "Supplier")'">
                        <span class="material-symbols-outlined">add</span>
                        Добавить офис
                    </button>
                }
            </div>

            <!-- Только один контейнер для карты -->
            <div id="supplierMapContainer" style="height: 300px; width: 100%; border-radius: 12px; margin-top: 16px;"
                 data-lat="@(Model.Office?.Latitude ?? 0)"
                 data-lng="@(Model.Office?.Longitude ?? 0)"
                 data-address="@(Model.Office?.Address ?? "")"
                 data-has-office="@(Model.Office != null ? "true" : "false")">
            </div>

            <div class="map-info">
                <div class="map-info-item">
                    <span class="material-symbols-outlined">schedule</span>
                    <div>
                        <strong>Часы работы</strong>
                        <span>Пн-Пт: 9:00 - 18:00</span>
                        <span>Сб: 10:00 - 15:00</span>
                    </div>
                </div>
                <div class="map-info-item">
                    <span class="material-symbols-outlined">call</span>
                    <div>
                        <strong>Контакты</strong>
                        <span>+375 (17) 123-45-67</span>
                        <span>@User.Identity?.Name</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    // Поиск и фильтрация таблицы
    function initTableFilters() {
        const searchInput = document.getElementById('searchEquipment');
        const categoryFilter = document.getElementById('categoryFilter');
        const tableRows = document.querySelectorAll('#equipmentTable tbody tr');

        function filterTable() {
            const searchTerm = searchInput.value.toLowerCase();
            const categoryTerm = categoryFilter.value.toLowerCase();

            tableRows.forEach(row => {
                const name = row.querySelector('.name-cell strong')?.textContent.toLowerCase() || '';
                const category = row.getAttribute('data-category')?.toLowerCase() || '';

                const matchesSearch = searchTerm === '' || name.includes(searchTerm);
                const matchesCategory = categoryTerm === '' || category === categoryTerm;

                if (matchesSearch && matchesCategory) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });

            // Обновляем счётчик
            const visibleRows = Array.from(tableRows).filter(row => row.style.display !== 'none').length;
            const resultsSpan = document.querySelector('.results .results-number');
            if (resultsSpan) {
                resultsSpan.textContent = visibleRows;
            }
        }

        if (searchInput) {
            searchInput.addEventListener('input', filterTable);
        }
        if (categoryFilter) {
            categoryFilter.addEventListener('change', filterTable);
        }
    }

    // Инициализация карты с Яндекс.Картами
    function initMap() {
        const mapContainer = document.getElementById('supplierMapContainer');
        if (!mapContainer) return;

        // Получаем координаты из data-атрибутов контейнера
        const lat = parseFloat(mapContainer.dataset.lat);
        const lng = parseFloat(mapContainer.dataset.lng);
        const address = mapContainer.dataset.address;

        // Проверяем, есть ли реальные координаты (не дефолтные или не нулевые)
        const hasValidOffice = mapContainer.dataset.hasOffice === 'true';

        if (typeof ymaps === 'undefined') {
            setTimeout(initMap, 500);
            return;
        }

        ymaps.ready(function () {
            // Если нет офиса, показываем карту без метки или с сообщением
            if (!hasValidOffice || isNaN(lat) || isNaN(lng) || (lat === 53.9045 && lng === 27.5615 && !address.includes('Промышленная'))) {
                const map = new ymaps.Map("supplierMapContainer", {
                    center: [53.9045, 27.5615],
                    zoom: 12,
                    controls: ['zoomControl', 'fullscreenControl']
                });

                // Добавляем метку с сообщением, что офис не добавлен
                const placemark = new ymaps.Placemark([53.9045, 27.5615], {
                    balloonContent: `<strong>Офис не добавлен</strong><br>Добавьте информацию о вашем офисе через кнопку "Добавить офис"`,
                    hintContent: 'Офис не добавлен'
                }, {
                    preset: 'islands#grayHomeCircleIcon',
                    draggable: false
                });

                map.geoObjects.add(placemark);
                return;
            }

            // Если есть офис, показываем его
            const map = new ymaps.Map("supplierMapContainer", {
                center: [lat, lng],
                zoom: 15,
                controls: ['zoomControl', 'fullscreenControl']
            });

            const placemark = new ymaps.Placemark([lat, lng], {
                balloonContent: `<strong>${address || 'Мой офис'}</strong><br><span style="color:#64748b;">🕐 Пн-Пт: 9:00 - 18:00</span>`
            }, {
                preset: 'islands#redHomeCircleIcon',
                draggable: false
            });

            map.geoObjects.add(placemark);
            placemark.balloon.open();
        });
    }

    // Запускаем инициализацию после загрузки страницы
    document.addEventListener('DOMContentLoaded', function() {
        initTableFilters();
        // Используем Яндекс.Карты вместо Leaflet
        if (typeof ymaps !== 'undefined') {
            initMap();
        } else {
            // Ждем загрузки Яндекс.Карт
            setTimeout(initMap, 1000);
        }
    });
</script>