@model IEnumerable<TechRent.Models.Entities.Office>
@{
    ViewData["Title"] = "Офисы";
    ViewData["css"] = "admin";
}

<main class="main-content">
    <div class="wrapper">
        <div class="breadcrumb">
            <a href="#" class="breadcrumb-link">Админ</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <span class="breadcrumb-current">Офисы</span>
        </div>

        <div class="page-header">
            <h1 class="page-title">Офисы и точки выдачи</h1>
            <button class="add-button" onclick="location.href='@Url.Action("CreateOffice", "Admin")'">
                <span class="material-symbols-outlined">add</span>
                Добавить офис
            </button>
        </div>

        <div class="admin-layout">
            <section class="table-section" style="width:100%;">
                <div id="officesMap" style="width:100%; height:400px; border-radius:12px; margin-bottom:24px;"></div>

                <div class="table-wrapper">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Название</th>
                                <th>Адрес</th>
                                <th>Широта</th>
                                <th>Долгота</th>
                                <th>Поставщик</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var office in Model)
                            {
                                <tr>
                                    <td class="id-cell">@office.Id</td>
                                    <td><strong>@office.Name</strong></td>
                                    <td>@(office.Address ?? "—")</td>
                                    <td>@office.Latitude.ToString("F6")</td>
                                    <td>@office.Longitude.ToString("F6")</td>
                                    <td>@(office.Supplier?.Email?.Split('@')[0] ?? "—")</td>
                                    <td class="actions-cell">
                                        <div class="action-buttons">
                                            <button class="action-button edit-button" title="Редактировать"
                                                    onclick="location.href='@Url.Action("EditOffice", "Admin", new { id = office.Id })'">
                                                <span class="material-symbols-outlined">edit</span>
                                            </button>
                                            <button class="action-button delete-button" title="Удалить"
                                                    onclick="location.href='@Url.Action("DeleteOffice", "Admin", new { id = office.Id })'">
                                                <span class="material-symbols-outlined">delete</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
</main>

<script src="https://api-maps.yandex.ru/2.1/?apikey=0d3a4764-1b1f-41ba-bc00-42c76b73e45f&lang=ru_RU" type="text/javascript"></script>
<script>
    // Сериализуем данные офисов в JavaScript
    var officesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(o => new {
        id = o.Id,
        name = o.Name,
        latitude = o.Latitude,
        longitude = o.Longitude,
        address = o.Address ?? "",
        supplier = o.Supplier != null ? o.Supplier.Email?.Split('@')[0] : ""
    })));

    function initOfficesMap() {
        if (typeof ymaps === 'undefined') {
            setTimeout(initOfficesMap, 500);
            return;
        }

        ymaps.ready(function () {
            // Определяем центр карты
            var centerLat = 53.9045;
            var centerLng = 27.5615;
            var zoom = 10;

            // Если есть офисы, центрируем на первом
            if (officesData && officesData.length > 0 && officesData[0].latitude && officesData[0].longitude) {
                centerLat = officesData[0].latitude;
                centerLng = officesData[0].longitude;
                zoom = 11;
            }

            var map = new ymaps.Map("officesMap", {
                center: [centerLat, centerLng],
                zoom: zoom,
                controls: ['zoomControl', 'fullscreenControl']
            });

            // Добавляем метки для всех офисов
            if (officesData && officesData.length > 0) {
                officesData.forEach(function (office) {
                    if (office.latitude && office.longitude && office.latitude !== 0 && office.longitude !== 0) {
                        var balloonContent = '<strong>' + escapeHtml(office.name) + '</strong>';
                        if (office.address) balloonContent += '<br>' + escapeHtml(office.address);
                        if (office.supplier) balloonContent += '<br><span style="color:#64748b;">Поставщик: ' + escapeHtml(office.supplier) + '</span>';
                        
                        var placemark = new ymaps.Placemark(
                            [office.latitude, office.longitude],
                            {
                                balloonContent: balloonContent,
                                hintContent: office.name
                            },
                            {
                                preset: 'islands#blueHomeCircleIcon'
                            }
                        );
                        map.geoObjects.add(placemark);
                    }
                });
            } else {
                // Если нет офисов, показываем сообщение
                var messagePlacemark = new ymaps.Placemark(
                    [centerLat, centerLng],
                    {
                        balloonContent: '<strong>Нет добавленных офисов</strong><br>Нажмите "Добавить офис" чтобы создать первый офис.',
                        hintContent: 'Нет офисов'
                    },
                    {
                        preset: 'islands#grayStretchyIcon',
                        draggable: false
                    }
                );
                map.geoObjects.add(messagePlacemark);
                messagePlacemark.balloon.open();
            }
        });
    }

    // Функция для экранирования HTML
    function escapeHtml(str) {
        if (!str) return '';
        return str
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    // Запускаем инициализацию карты
    document.addEventListener('DOMContentLoaded', function() {
        initOfficesMap();
    });
</script>